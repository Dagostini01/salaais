{
  "expo": {
    "name": "Sala AIS",
    "owner": "sala_ais",
    "slug": "salaais",
    "scheme": "salaais",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo-amarelo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo-amarelo-removebg.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbd434"
    },
    "ios": {
      "buildNumber": "2.0.0",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.sala.ais",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) precisa da sua permissão para usar a câmera para autenticar com o Apple."
      }
    },
    "android": {
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo-amarelo-removebg.png",
        "backgroundColor": "#fbcb04"
      },
      "package": "com.salaais"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3a741fa4-6e21-4ae6-8737-110452c060ac"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep public class com.horcrux.svg.** { *; }\n-keep class com.stripe.** { *; }\n-keep class com.reactnativegooglesignin.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn com.stripe.**\n-dontwarn com.google.android.gms.**"
          }
        }
      ],
      "./plugins",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.178145981087-g3719f08ontptnscrjco6brli473dd48"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3a741fa4-6e21-4ae6-8737-110452c060ac",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
